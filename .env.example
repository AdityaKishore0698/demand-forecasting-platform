# Copy to .env (never commit the real file). All values are optional.

# Where the API loads the trained model + serving snapshot from.
ARTIFACT_DIR=artifacts

# Comma-separated browser origins allowed to call the API (CORS).
# Add your deployed frontend URL here, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Python logging level for the API.
LOG_LEVEL=INFO
